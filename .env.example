# ============================================================================
# WealthWise AI Backend — Environment Variables
# ============================================================================

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# MongoDB
MONGODB_URI=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRY=24h

# OpenAI (Primary LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-11-20

# Gemini (Alternative LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Cashfree API Credentials (Get these from Cashfree Dashboard)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX